{
  "name": "@email-service/database",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./migrations": {
      "types": "./dist/migrations/index.d.ts",
      "import": "./dist/migrations/index.js",
      "require": "./dist/migrations/index.js"
    },
    "./repositories": {
      "types": "./dist/repositories/index.d.ts",
      "import": "./dist/repositories/index.js",
      "require": "./dist/repositories/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node dist/migrations/cli.js migrate",
    "db:rollback": "node dist/migrations/cli.js rollback",
    "db:seed": "node dist/seeds/cli.js"
  },
  "dependencies": {
    "@email-service/config": "workspace:*",
    "@email-service/errors": "workspace:*",
    "@email-service/logger": "workspace:*",
    "@email-service/types": "workspace:*",
    "kysely": "^0.27.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@email-service/tsconfig": "workspace:*",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}