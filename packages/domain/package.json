{
  "name": "@resendbyte/domain",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1096.0",
    "@aws-sdk/client-ses": "^3.1089.0",
    "@aws-sdk/s3-request-presigner": "^3.1096.0",
    "@resendbyte/config": "workspace:*",
    "@resendbyte/crypto": "workspace:*",
    "@resendbyte/database": "workspace:*",
    "@resendbyte/errors": "workspace:*",
    "@resendbyte/logger": "workspace:*",
    "@resendbyte/queue": "workspace:*",
    "@resendbyte/types": "workspace:*",
    "kysely": "^0.27.0",
    "nodemailer": "^9.0.3"
  },
  "devDependencies": {
    "@resendbyte/tsconfig": "workspace:*",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.1",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}