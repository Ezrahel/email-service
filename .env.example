# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/email_service
DATABASE_POOL_SIZE=10
DATABASE_STATEMENT_TIMEOUT=5000

# Redis
REDIS_URL=redis://localhost:6379
REDIS_POOL_SIZE=15

# JWT
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800

# API Keys
API_KEY_PREFIX=em_
API_KEY_HASH_ALGORITHM=sha256

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# Email Providers (optional - configure as needed)
# SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_BASE_URL=

# SendGrid
SENDGRID_API_KEY=

# AWS SES
SES_REGION=
SES_ACCESS_KEY=
SES_SECRET_KEY=

# Postmark
POSTMARK_API_KEY=

# Storage (S3-compatible)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=email-service
SENTRY_DSN=