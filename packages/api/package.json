{
  "name": "@resendbyte/api",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@fastify/compress": "^6.5.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/helmet": "^11.1.0",
    "@fastify/multipart": "^8.3.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^4.0.0",
    "@resendbyte/config": "workspace:*",
    "@resendbyte/crypto": "workspace:*",
    "@resendbyte/database": "workspace:*",
    "@resendbyte/domain": "workspace:*",
    "@resendbyte/errors": "workspace:*",
    "@resendbyte/logger": "workspace:*",
    "@resendbyte/queue": "workspace:*",
    "@resendbyte/smtp-gateway": "workspace:*",
    "@resendbyte/telemetry": "workspace:*",
    "@resendbyte/types": "workspace:*",
    "@better-auth/kysely-adapter": "^1.6.23",
    "@better-auth/core": "^1.6.23",
    "better-auth": "^1.6.23",
    "fastify": "^4.28.0",
    "kysely": "^0.27.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@resendbyte/tsconfig": "workspace:*",
    "@types/node": "^20.14.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
